pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_SESSION_TOKEN     = credentials('aws-session-token')
        AWS_DEFAULT_REGION    = 'us-east-1'
    }

    stages {

        stage('Get Code') {
            agent any
            steps {
                sh 'whoami ; hostname ; hostname -I ; uname -a'
                git branch: 'develop',
                    url: 'https://github.com/Gonzalo-Pascual/todo-list-aws.git'
                echo "WORKSPACE: ${env.WORKSPACE}"
                sh 'git rev-parse --abbrev-ref HEAD'
                sh 'ls -la'
                // Guardamos el código para usarlo en otros agentes
                stash name: 'codigo', includes: '**/*'
            }
        }

        stage('Static Test') {
            // Agente dedicado para pruebas estáticas
            agent { label 'agente1' }
            steps {
                unstash 'codigo'
                sh '''
                    flake8 --exit-zero --format=pylint src > flake8.out
                    cat flake8.out
                '''
                recordIssues(
                    id: 'flake8',
                    tools: [pyLint(name: 'Flake8', pattern: 'flake8.out')]
                )
                sh '''
                    bandit --exit-zero -r src \
                        -f custom \
                        -o bandit.out \
                        --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                    cat bandit.out
                '''
                recordIssues(
                    id: 'bandit',
                    tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')]
                )
            }
        }

        stage('Deploy') {
            agent any
            steps {
                unstash 'codigo'
                sh '''
                    sam delete \
                        --stack-name todo-list-aws-staging \
                        --no-prompts \
                        --region ${AWS_DEFAULT_REGION} || true

                    sam build

                    sam validate --region ${AWS_DEFAULT_REGION}

                    sam deploy \
                        --stack-name todo-list-aws-staging \
                        --region ${AWS_DEFAULT_REGION} \
                        --capabilities CAPABILITY_IAM \
                        --no-confirm-changeset \
                        --no-fail-on-empty-changeset \
                        --parameter-overrides Stage=staging | tee deploy_output.txt
                '''
                // Guardamos la URL para el agente de tests
                script {
                    def baseUrl = sh(
                        script: "awk '/Key *BaseUrlApi/{getline; getline; print \$2}' deploy_output.txt",
                        returnStdout: true
                    ).trim()

                    if (!baseUrl) {
                        baseUrl = sh(
                            script: """
                                aws cloudformation describe-stacks \
                                    --stack-name todo-list-aws-staging \
                                    --region ${AWS_DEFAULT_REGION} \
                                    --query "Stacks[0].Outputs[?OutputKey=='BaseUrlApi'].OutputValue" \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()
                    }

                    // Guardamos la URL en fichero y en variable global
                    env.BASE_URL = baseUrl
                    writeFile file: 'base_url.txt', text: baseUrl
                    echo "API URL: ${env.BASE_URL}"
                }
                // Guardamos la URL para que el agente de tests la pueda leer
                stash name: 'url', includes: 'base_url.txt'
            }
        }

        stage('Rest Test') {
            // Agente dedicado para pruebas de integración
            agent { label 'agente2' }
            steps {
                // Recuperamos la URL guardada por el agente del Deploy
                unstash 'url'
                sh '''
                    BASE_URL=$(cat base_url.txt)
                    export BASE_URL=${BASE_URL}
                    echo "API URL: ${BASE_URL}"

                    python3 -m pytest test/integration/todoApiTest.py \
                        --junitxml=result-rest.xml \
                        -v
                '''
            }
            post {
                always {
                    junit 'result-rest.xml'
                }
            }
        }

        stage('Promote') {
            agent any
            steps {
                unstash 'codigo'
                withCredentials([usernamePassword(
                    credentialsId: 'github-token',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        git config user.email "jenkins@ci.local"
                        git config user.name "Jenkins CI"
                        git remote set-url origin https://${GIT_USER}:${GIT_TOKEN}@github.com/Gonzalo-Pascual/todo-list-aws.git
                        git fetch origin
                    
                        git checkout master
                        git merge origin/develop --no-ff \
                            -m "CI: Merge develop into master [auto]" \
                            -X theirs
                    
                        # Solo protegemos el Jenkinsfile de master (CD), no el Jenkinsfile_agentes
                        git checkout origin/master -- Jenkinsfile
                        git add Jenkinsfile
                        git diff --cached --quiet || git commit --amend --no-edit
                    
                        git push origin master
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}