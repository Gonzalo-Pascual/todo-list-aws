pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_SESSION_TOKEN     = credentials('aws-session-token')
        AWS_DEFAULT_REGION    = 'us-east-1'
    }

    stages {

        // ETAPA 1: GET CODE - descarga código (develop) + samconfig.toml (staging)
        stage('Get Code') {
            steps {
                sh 'whoami ; hostname ; hostname -I ; uname -a'

                // Repo principal - rama develop
                git branch: 'develop',
                    url: 'https://github.com/Gonzalo-Pascual/todo-list-aws.git'

                // Repo de config - rama staging (solo samconfig.toml)
                dir('config') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/staging']],
                        doGenerateSubmoduleConfigurations: false,
                        extensions: [
                            [$class: 'SparseCheckoutPaths',
                             sparseCheckoutPaths: [
                                 [$class: 'SparseCheckoutPath', path: 'samconfig.toml']
                             ]]
                        ],
                        userRemoteConfigs: [[url: 'https://github.com/Gonzalo-Pascual/todo-list-aws-config.git']]
                    ])
                }

                // Mover samconfig.toml al workspace raíz (sobreescribe el del repo de código)
                sh '''
                    mv config/samconfig.toml .
                    rm -rf config
                    echo "=== samconfig.toml de staging ==="
                    cat samconfig.toml
                    ls -la
                '''

                echo "WORKSPACE: ${env.WORKSPACE}"
                sh 'git rev-parse --abbrev-ref HEAD'
                stash name: 'codigo', includes: '**/*'
            }
        }

        // ETAPA 2: PRUEBAS ESTÁTICAS - agente1
        stage('Static Test') {
            agent { label 'agente1' }
            steps {
                sh 'whoami ; hostname ; hostname -I'
                unstash 'codigo'
                sh '''
                    flake8 --exit-zero --format=pylint src > flake8.out
                    cat flake8.out
                '''
                recordIssues(
                    id: 'flake8',
                    tools: [pyLint(name: 'Flake8', pattern: 'flake8.out')]
                )
                sh '''
                    bandit --exit-zero -r src \
                        -f custom \
                        -o bandit.out \
                        --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                    cat bandit.out
                '''
                recordIssues(
                    id: 'bandit',
                    tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')]
                )
            }
        }

        // ETAPA 3: DESPLIEGUE EN STAGING - agente principal
        stage('Deploy') {
            steps {
                sh 'whoami ; hostname ; hostname -I'
                unstash 'codigo'
                sh '''
                    sam build
                    sam validate --region ${AWS_DEFAULT_REGION}
                    sam deploy \
                        --config-env staging \
                        --no-confirm-changeset \
                        --no-fail-on-empty-changeset
                '''
                script {
                    env.BASE_URL = sh(
                        script: '''
                            aws cloudformation describe-stacks \
                                --stack-name todo-list-aws-staging \
                                --region ${AWS_DEFAULT_REGION} \
                                --query "Stacks[0].Outputs[?OutputKey=='BaseUrlApi'].OutputValue" \
                                --output text
                        ''',
                        returnStdout: true
                    ).trim()
                    echo "BASE_URL: ${env.BASE_URL}"
                    writeFile file: 'base_url.txt', text: env.BASE_URL
                    stash name: 'url', includes: 'base_url.txt'
                }
            }
        }

        // ETAPA 4: PRUEBAS DE INTEGRACIÓN - agente2
        stage('Rest Test') {
            agent { label 'agente2' }
            steps {
                sh 'whoami ; hostname ; hostname -I'
                unstash 'codigo'
                unstash 'url'
                sh '''
                    BASE_URL=$(cat base_url.txt)
                    export BASE_URL=${BASE_URL}
                    echo "API URL: ${BASE_URL}"

                    python3 -m pytest test/integration/todoApiTest.py \
                        --junitxml=result-rest.xml \
                        -v
                '''
            }
            post {
                always {
                    junit 'result-rest.xml'
                }
            }
        }

        // ETAPA 5: PROMOTE - agente principal
        stage('Promote') {
            steps {
                sh 'whoami ; hostname ; hostname -I'
                unstash 'codigo'
                withCredentials([usernamePassword(
                    credentialsId: 'github-token',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        git config user.email "jenkins@ci.local"
                        git config user.name "Jenkins CI"
                        git remote set-url origin https://${GIT_USER}:${GIT_TOKEN}@github.com/Gonzalo-Pascual/todo-list-aws.git
                        git fetch origin
                        git checkout -- samconfig.toml
                        git checkout master
                        git merge origin/develop --no-ff -m "CI: Merge develop into master [auto]"
                        git push origin master
                        git remote set-url origin https://github.com/Gonzalo-Pascual/todo-list-aws.git
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}