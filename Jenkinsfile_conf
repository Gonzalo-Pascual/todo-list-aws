pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_SESSION_TOKEN     = credentials('aws-session-token')
        AWS_DEFAULT_REGION    = 'us-east-1'
    }

    stages {

        // ETAPA 1: GET CODE
        // Descarga el código fuente de develop Y el samconfig.toml de staging
        // usando sparse checkout para traer solo el fichero necesario del repo de config
        stage('Get Code') {
            agent any
            steps {
                sh 'whoami ; hostname ; hostname -I ; uname -a'

                // 1a. Clonar el repo principal (rama develop) SIN samconfig.toml
                //     para asegurarnos de que no usamos el que viene en el repo de código
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/develop']],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [
                        [$class: 'SparseCheckoutPaths',
                         sparseCheckoutPaths: [
                             [$class: 'SparseCheckoutPath', path: '/*'],
                             [$class: 'SparseCheckoutPath', path: '!/samconfig.toml']
                         ]]
                    ],
                    userRemoteConfigs: [[url: 'https://github.com/Gonzalo-Pascual/todo-list-aws.git']]
                ])

                // 1b. Clonar el repo de config (rama staging) en subdirectorio temporal
                //     trayendo únicamente el samconfig.toml
                dir('config') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/staging']],
                        doGenerateSubmoduleConfigurations: false,
                        extensions: [
                            [$class: 'SparseCheckoutPaths',
                             sparseCheckoutPaths: [
                                 [$class: 'SparseCheckoutPath', path: 'samconfig.toml']
                             ]]
                        ],
                        userRemoteConfigs: [[url: 'https://github.com/Gonzalo-Pascual/todo-list-aws-config.git']]
                    ])
                }

                // 1c. Mover samconfig.toml al workspace raíz y limpiar el directorio temporal
                sh '''
                    mv config/samconfig.toml .
                    rm -rf config
                    echo "=== Verificación: samconfig.toml de staging ==="
                    cat samconfig.toml
                    ls -la
                '''

                echo "WORKSPACE: ${env.WORKSPACE}"
                sh 'git rev-parse --abbrev-ref HEAD'

                // Guardamos todo el workspace (código + samconfig de staging) para los agentes
                stash name: 'codigo', includes: '**/*'
            }
        }

        // ETAPA 2: PRUEBAS ESTÁTICAS
        stage('Static Test') {
            agent { label 'agente1' }
            steps {
                unstash 'codigo'
                sh '''
                    flake8 --exit-zero --format=pylint src > flake8.out
                    cat flake8.out
                '''
                recordIssues(
                    id: 'flake8',
                    tools: [pyLint(name: 'Flake8', pattern: 'flake8.out')]
                )
                sh '''
                    bandit --exit-zero -r src \
                        -f custom \
                        -o bandit.out \
                        --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                    cat bandit.out
                '''
                recordIssues(
                    id: 'bandit',
                    tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')]
                )
            }
        }

        // ETAPA 3: DESPLIEGUE EN STAGING
        // Usa el samconfig.toml descargado del repo de config (rama staging)
        stage('Deploy') {
            agent any
            steps {
                unstash 'codigo'
                sh '''
                    sam delete \
                        --stack-name todo-list-aws-staging \
                        --no-prompts \
                        --region ${AWS_DEFAULT_REGION} || true

                    sam build

                    sam validate --region ${AWS_DEFAULT_REGION}

                    # --config-env staging lee la sección [staging] del samconfig.toml
                    # que viene del repo de config, no del repo de código
                    sam deploy \
                        --config-env staging \
                        --no-confirm-changeset \
                        --no-fail-on-empty-changeset | tee deploy_output.txt
                '''
                script {
                    def baseUrl = sh(
                        script: "awk '/Key *BaseUrlApi/{getline; getline; print \$2}' deploy_output.txt",
                        returnStdout: true
                    ).trim()

                    if (!baseUrl) {
                        baseUrl = sh(
                            script: """
                                aws cloudformation describe-stacks \
                                    --stack-name todo-list-aws-staging \
                                    --region ${AWS_DEFAULT_REGION} \
                                    --query "Stacks[0].Outputs[?OutputKey=='BaseUrlApi'].OutputValue" \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()
                    }

                    env.BASE_URL = baseUrl
                    writeFile file: 'base_url.txt', text: baseUrl
                    echo "API URL: ${env.BASE_URL}"
                }
                stash name: 'url', includes: 'base_url.txt'
            }
        }

        // ETAPA 4: PRUEBAS DE INTEGRACIÓN
        stage('Rest Test') {
            agent { label 'agente2' }
            steps {
                unstash 'url'
                sh '''
                    BASE_URL=$(cat base_url.txt)
                    export BASE_URL=${BASE_URL}
                    echo "API URL: ${BASE_URL}"

                    python3 -m pytest test/integration/todoApiTest.py \
                        --junitxml=result-rest.xml \
                        -v
                '''
            }
            post {
                always {
                    junit 'result-rest.xml'
                }
            }
        }

        // ETAPA 5: PROMOTE
        stage('Promote') {
            agent any
            steps {
                unstash 'codigo'
                withCredentials([usernamePassword(
                    credentialsId: 'github-token',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        git config user.email "jenkins@ci.local"
                        git config user.name "Jenkins CI"
                        git remote set-url origin https://${GIT_USER}:${GIT_TOKEN}@github.com/Gonzalo-Pascual/todo-list-aws.git
                        git fetch origin
                    
                        # Descartar el samconfig.toml externo antes de cambiar de rama
                        git checkout -- samconfig.toml
                    
                        git checkout master
                        git reset --hard origin/master
                    
                        git merge origin/develop --no-ff \
                            -m "CI: Merge develop into master [auto]" \
                            -X theirs
                    
                        git checkout origin/master -- Jenkinsfile
                        git checkout origin/master -- Jenkinsfile_agentes
                        git add Jenkinsfile Jenkinsfile_agentes
                        git diff --cached --quiet || git commit --amend --no-edit
                    
                        git push origin master
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
